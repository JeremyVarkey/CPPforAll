---
/** Chapter rail — brand, search, the 29 chapter rows, footer. Rows are real
 *  links (static HTML); the search filter is a small vanilla script so notes
 *  pages ship zero framework JS (React arrives only with the Phase B runner). */
import Icon from './Icon.astro';

interface Chapter {
  num: number; slug: string; title: string; tag: string; hasDrill: boolean;
}
interface Props { chapters: Chapter[]; current: number | null }
const { chapters, current } = Astro.props;
---

<div class="rail-inner">
  <div class="rail-head">
    <div class="brand">
      <a class="brand-mark" href="/" title="Home" aria-label="CPPforAll home">
        <Icon name="spark" class="spark" />
        <span class="brand-name">CPP<b>for</b>All</span>
      </a>
      <button class="icon-btn" data-action="collapse" aria-label="Collapse sidebar" title="Collapse sidebar">
        <Icon name="sidebar" />
      </button>
    </div>
    <div class="search">
      <Icon name="search" />
      <input id="rail-search" placeholder="Search chapters…" aria-label={`Search ${chapters.length} chapters`} autocomplete="off" />
      <button class="clear" id="rail-search-clear" aria-label="Clear search" hidden>
        <Icon name="x" />
      </button>
    </div>
  </div>
  <div class="rail-label" id="rail-label">All chapters</div>
  <div class="chapters" id="chapter-list">
    {chapters.map((c) => (
      <a
        class={'ch-row' + (current === c.num ? ' active' : '')}
        href={`/chapters/${c.slug}/`}
        aria-current={current === c.num ? 'page' : undefined}
        data-ch-row
        data-num={c.num}
        data-search={`${c.num} chapter ${c.num} ${c.title} ${c.tag}`.toLowerCase()}
      >
        <span class="ch-num">{c.slug}</span>
        <span class="ch-main">
          <span class="ch-title">{c.title}</span>
          <span class="ch-tag">{c.tag}</span>
        </span>
      </a>
    ))}
    <div class="no-results" id="no-results" hidden></div>
  </div>
  <div class="rail-foot">
    <span class="foot-meta">29 chapters · free &amp; open</span>
  </div>
</div>

<script is:inline>
  (function () {
    var input = document.getElementById('rail-search');
    var clear = document.getElementById('rail-search-clear');
    var label = document.getElementById('rail-label');
    var none = document.getElementById('no-results');
    if (!input) return;
    function apply() {
      var q = input.value.trim().toLowerCase();
      var rows = document.querySelectorAll('[data-ch-row]');
      var shown = 0;
      rows.forEach(function (row) {
        var hit = !q || (row.dataset.search || '').indexOf(q) !== -1;
        row.hidden = !hit;
        if (hit) shown++;
      });
      label.textContent = q ? shown + ' result' + (shown === 1 ? '' : 's') : 'All chapters';
      none.hidden = shown !== 0;
      none.textContent = 'No chapters match “' + input.value + '”.';
      clear.hidden = !q;
    }
    input.addEventListener('input', apply);
    clear.addEventListener('click', function () { input.value = ''; apply(); input.focus(); });
  })();
</script>
